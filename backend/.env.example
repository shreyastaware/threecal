ENVIRONMENT=development
DATABASE_URL=sqlite:///./threecal.db
AUTO_CREATE_TABLES=true
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Single-use emailed links (email verification and password reset).
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Rate limiting. Set TRUST_PROXY_HEADERS=true only behind a proxy that sets
# X-Forwarded-For (Railway); otherwise clients could spoof their IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://localhost:3000
# Email delivery (use smtp in production; Brevo supports standard SMTP credentials)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bookings@threecal.com
WEBHOOK_SECRET=change-me
# Use a separate random value of at least 32 characters in production.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-random-32-character-secret
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Cloudflare R2 profile image storage. R2_PUBLIC_BASE_URL should be your
# public bucket URL or custom domain, for example https://assets.threecal.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Daily SQLite backups to R2 (bucket defaults to R2_BUCKET_NAME; use a private bucket).
BACKUP_R2_BUCKET_NAME=
BACKUP_PREFIX=backups/
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=3
# In-process jobs (expire pending bookings every N minutes, daily backup). Enable on the API service.
SCHEDULER_ENABLED=false
EXPIRE_PENDING_BOOKINGS_INTERVAL_MINUTES=5
# Booking self-service and reminders. Invitees can cancel/reschedule until the cutoff before the start.
INVITEE_CHANGE_CUTOFF_HOURS=24
# Reminder emails in minutes before the start; reminders more than REMINDER_GRACE_MINUTES late are skipped.
REMINDER_OFFSETS_MINUTES=1440,60
REMINDER_GRACE_MINUTES=30
SEND_BOOKING_REMINDERS_INTERVAL_MINUTES=5
# Sentry (disabled when SENTRY_DSN is empty). SENTRY_ENVIRONMENT defaults to ENVIRONMENT,
# SENTRY_RELEASE defaults to RAILWAY_GIT_COMMIT_SHA.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Logging: JSON to stdout. Set LOKI_URL (e.g. https://logs-prod-012.grafana.net) to also push to
# Grafana Loki; for Grafana Cloud, LOKI_USERNAME is the numeric user id and LOKI_PASSWORD an access token.
LOG_LEVEL=INFO
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
# Platform Razorpay account (Route). Invitee payments land here and the host
# share is transferred to each host's Route linked account automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the platform webhook pointing at /api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com
# Platform commission in basis points (250 = 2.5%)
PLATFORM_COMMISSION_BPS=0
# Calendar + conferencing integrations (leave empty to disable; endpoints return 503).
# Register these OAuth redirect URIs (PUBLIC_API_URL + /api/v1):
#   Google Cloud console:  ${PUBLIC_API_URL}/api/v1/calendars/oauth/google/callback
#   Azure app (Entra ID):  ${PUBLIC_API_URL}/api/v1/calendars/oauth/microsoft/callback
#   Zoom Marketplace app:  ${PUBLIC_API_URL}/api/v1/conferencing/oauth/zoom/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Seconds to cache busy times read from connected calendars.
CALENDAR_BUSY_CACHE_SECONDS=60
