ENVIRONMENT=development
DATABASE_URL=sqlite:///./threecal.db
AUTO_CREATE_TABLES=true
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
# Email delivery (use smtp in production; Brevo supports standard SMTP credentials)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bookings@threecal.com
WEBHOOK_SECRET=change-me
# Use a separate random value of at least 32 characters in production.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-random-32-character-secret
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Cloudflare R2 profile image storage. R2_PUBLIC_BASE_URL should be your
# public bucket URL or custom domain, for example https://assets.threecal.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_AUTHORIZE_URL=https://www.sandbox.paypal.com/signin/authorize
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
RAZORPAY_OAUTH_MODE=test
CASHFREE_OAUTH_CLIENT_ID=
CASHFREE_PARTNER_API_KEY=
CASHFREE_API_URL=https://api-sandbox.cashfree.com
CASHFREE_PAYMENTS_URL=https://sandbox.cashfree.com
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_API_URL=https://test.dodopayments.com
DODO_PAYMENTS_PRODUCT_ID=
BILLING_CRON_SECRET=replace-with-a-random-cron-secret
