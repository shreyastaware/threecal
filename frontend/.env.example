NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Sentry error monitoring (fully disabled when NEXT_PUBLIC_SENTRY_DSN is empty).
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to NEXT_PUBLIC_VERCEL_ENV, then NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build-time only: source maps are uploaded when all three are set (keep the token secret).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
